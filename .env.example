# ---- copy to .env and fill in; NEVER commit the real .env ----

# Targets
BASE_URL=https://uat-avanse.sprintexcrow.in
API_BASE_URL=https://uat-avanse.sprintexcrow.in

# Admin credentials (rotate the exposed UAT password and put the NEW one here)
ADMIN_EMAIL=anand.kumar@paysprint.in
ADMIN_PASSWORD=Patan@12

# A limited-role (non-admin) user for access-control tests
USER_EMAIL=
USER_PASSWORD=

# A user configured as Maker (to verify maker != checker)
MAKER_EMAIL=
MAKER_PASSWORD=

# OTP handling: gmail_web | imap | static | api | manual
# gmail_web = Gmail opened in the browser, newest code copied automatically; you only
#             enter Google's 2-step code once (session saved to GMAIL_STATE). pytest --headed
# manual    = type the mailed code into the browser yourself (pytest --headed)
OTP_STRATEGY=gmail_web
MAIL_PASSWORD=
GMAIL_STATE=.auth/gmail_state.json
GMAIL_LOGIN_TIMEOUT_S=300
OTP_STATIC=
OTP_API_URL=
OTP_MANUAL_TIMEOUT_S=180

# Mailbox read by OTP_STRATEGY=imap and the forgot-password test.
# Gmail needs an App Password (https://myaccount.google.com/apppasswords).
MAIL_IMAP_HOST=imap.gmail.com
MAIL_USER=
MAIL_APP_PASSWORD=
OTP_MAIL_SUBJECT=Your SprintEXcrow sign-in code
RESET_MAIL_SUBJECT=password
OTP_MAIL_TIMEOUT_S=90

# Password saved by the forgot-password flow (git-ignored under .auth/)
CREDENTIALS_STORE=.auth/credentials.json
RESET_NEW_PASSWORD=

# Geolocation (sign-in needs Allow Location). Default = Delhi.
GEO_LAT=28.6139
GEO_LNG=77.2090

# Report: one page per run, reports/Test_Report_<run_id>.html (screenshots/videos embedded up to this size)
REPORT_EMBED_MAX_MB=60
# 0 = keep every run and report (default)
REPORT_KEEP_RUNS=0

# Runtime
HEADLESS=true
BROWSER=chromium
DEFAULT_TIMEOUT_MS=30000
REUSE_AUTH=1

# API endpoint overrides (confirm each against DevTools > Network)
# EP_LOGIN=/api/auth/login
# EP_BENEFICIARIES=/api/beneficiaries
# EP_TRANSFERS=/api/transfers
# EP_USERS=/api/users
# EP_ROLES=/api/roles
# EP_AUDIT=/api/audit-trail
